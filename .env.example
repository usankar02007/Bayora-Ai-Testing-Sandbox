# Bayora AI Safety Platform - Environment Configuration Example
# Copy this file to .env or backend/.env and replace placeholder values.
# NEVER commit real credentials to version control.

# Authentication Tokens
RED_TEAM_TOKEN=example-red-team-token-secret-replace-me
BLUE_TEAM_TOKEN=example-blue-team-token-secret-replace-me
ADMIN_TOKEN=example-admin-token-secret-replace-me

# Persistent Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bayora
# Fallback to sqlite:///bayora.db if PostgreSQL is unavailable

# Docker Sandbox Image
SANDBOX_IMAGE=bayora-sandbox:dev

# Model Providers
ALLOW_REMOTE_MODELS=false
LOCAL_MODEL_URL=http://localhost:11434/v1/chat/completions
LOCAL_MODEL_NAME=llama3
GEMINI_API_KEY=

# Optional TinyFish Integration
TINYFISH_API_KEY=sk-tinyfish-X7Htj_VahA4aLPaXIZ6hlq522iknrdR-
TINYFISH_URL=https://agent.tinyfish.ai/v1/automation/run
